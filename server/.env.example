# Copy this file to a new file called .env (in this same server folder)
# and put your own MongoDB connection string after the = sign.
#
# MongoDB Atlas (cloud): Atlas > your cluster > Connect > Drivers, then copy the string
# and replace <db_password> with your database user's password.
# MongoDB on your laptop: you can leave .env out completely, it uses mongodb://127.0.0.1:27017
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
